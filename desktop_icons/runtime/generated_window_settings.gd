class_name GeneratedWindowSettings
extends Resource
## A resource that controls settings for a window generated by a Desktop Icon.


## The window scene this window settings uses.
@export var window_scene: PackedScene:
	get:
		if not window_scene:
			return load(backup_window_scene_path)
		return window_scene
@export var backup_window_scene_path: String

@export var aditional_values: Dictionary[String, Variant]

@export_group("Opening Options")
@export var ignore_cap: bool = false
@export var toggle: bool = true

@export_group("Modifier")
@export var is_modifier: bool = false
@export var modifier_scene: PackedScene
@export var modifier_script: Script
@export var should_open_window: bool = false

## Sets property values of self, based on the (custom) cmdline arguments given.
## For getting cmdline arguments from values, see: [method property_values_to_cmdline_args].
func cmdline_args_to_property_values(cmdline_args: PackedStringArray) -> void:
	# get a refrence to all the valid properties that can be changed
	var valid_properties: Array[StringName]
	
	# get all the properties in this class
	var properties: Array[Dictionary] = get_property_list()
	
	# get only the user made properties for the valid properties
	for property: Dictionary[StringName, Variant] in properties:
		# make sure the valid properties are only the properties made by the script itself
		if property[&"usage"] & PROPERTY_USAGE_SCRIPT_VARIABLE:
			valid_properties.append(property[&"name"])
	
	
	# go through every argument in the cmdline arguments provided
	for argument: String in cmdline_args:
		# if there is a leading --, delete that
		argument = argument.trim_prefix("--")
		
		# if the argument is setting a value based on using a =,
		# set the value of the property to that new value specified
		if "=" in argument:
			# get the parts seperated of the setter argument
			var parts: PackedStringArray = argument.split("=", true, 1)
			
			# get the name of the property that will be set
			var prop_name: String = parts[0]
			# get the name of the value that will be set to the provided property
			var raw_value: String = parts[1]
			if raw_value.begins_with("{") and raw_value.ends_with("}"):
				var regex = RegEx.new()
				regex.compile("([\\{\\s,])([a-zA-Z_]\\w*)\\s*:")
				raw_value = regex.sub(raw_value, '$1"$2":', true)
			
			var parsed_result: Variant = JSON.parse_string(raw_value)
			
			var prop_value: Variant =\
			parsed_result if parsed_result != null or raw_value == "null" else raw_value
			print("Setting property: ", prop_name, " to value: ", prop_value, " (Type: ", typeof(prop_value), ")")
			
			# if the property wanted to be set is a valid property, set that property to new value
			if valid_properties.has(prop_name):
				var current_val = get(prop_name)
				# If both are dictionaries, use assign() to safely populate typed dictionaries
				if current_val is Dictionary and prop_value is Dictionary:
					current_val.assign(prop_value)
				else:
					set(prop_name, prop_value)
		
		# if the argument is a custom resource argument, set the value from the given path
		elif ":ResourceFromPath:" in argument:
			# get the parts seperated of the setter argument
			var parts: PackedStringArray = argument.split(":ResourceFromPath:", true, 1)
			
			# get the name of the property that will be set
			var prop_name: String = parts.get(0)
			# get the scene that the property will become
			var scene_path: String = parts.get(1)
			var prop_value: Resource = load(scene_path)
			
			if prop_value and valid_properties.has(prop_name):
				set(prop_name, prop_value)
		
		# if the property does not contain an =, it is a boolean flag, so set that property to true
		else:
			# check if the argument is a valid property
			if valid_properties.has(argument):
				set(argument, true)


## Gets all the properties of this [GeneratedWindowSettings],
## and translates those properties to a line of custom cmdline arguments and returns that.
func property_values_to_cmdline_args() -> String:
	# get a refrence to all the eventual custom cmdline arguments
	var cmdline_args: String = ""
	
	# get all the properties in this class
	var properties: Array[Dictionary] = get_property_list()
	
	# loop through all properties of this class
	for property: Dictionary[StringName, Variant] in properties:
		# check if the current property is made by a script
		if not property[&"usage"] & PROPERTY_USAGE_SCRIPT_VARIABLE:
			continue
		
		# get a refrence to the name of the property
		var property_name: String = property[&"name"]
		
		# get the type of property to do something diffrent for certain property types
		# and add the eventual result in the custom cmdline arguments
		match property[&"type"]:
			TYPE_BOOL:
				# if the property is a boolean value,
				# add it without a = that sets the value when true, don't add anything when false
				if get(property_name):
					cmdline_args += " --%s" %property_name
			TYPE_OBJECT:
				var value: Object = get(property_name)
				if value is Resource:
					var path: String = value.resource_path
					cmdline_args += ' --%s:ResourceFromPath:%s' %[property_name, path]
			_:
				# if the property does not use custom code for that property, use the name + value
				cmdline_args += " --%s=%s" %[property_name, JSON.stringify(get(property_name))]
	
	# return the end result of all the custom user cmdline arguments
	return cmdline_args
